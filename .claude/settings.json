{
  "permissions": {
    "allow": [
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(npm run build 2>&1)",
      "PowerShell(npx tsc -b 2>&1)",
      "PowerShell(npx tsc --noEmit -p tsconfig.json 2>&1 | Select-Object -First 60; Write-Output \"EXIT:$LASTEXITCODE\")",
      "PowerShell(npx tsc --noEmit -p tsconfig.app.json 2>&1 | Select-Object -First 100; Write-Output \"EXIT:$LASTEXITCODE\")"
    ]
  }
}
